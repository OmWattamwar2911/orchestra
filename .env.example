# ==============================================================================
# Orchestra Distributed Workflow Scheduler - Environment Variables Example
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Cluster Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of etcd endpoints
ETCD_ENDPOINTS=localhost:2379

# gRPC API port for orchestrator nodes
ORCHESTRATOR_PORT=50051

# HTTP Gateway / REST API port
GATEWAY_PORT=8080

# Unique node identifier within the orchestrator cluster (e.g., node-1, node-2)
NODE_ID=node-1

# Election lease TTL in seconds
ELECTION_TTL_SECONDS=5

# Health heartbeat timeout for workers in seconds
WORKER_HEARTBEAT_TIMEOUT_SECONDS=10

# Log level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Frontend Dashboard (Vite / React)
# ------------------------------------------------------------------------------
# Base URL of the Orchestra HTTP Gateway API
VITE_API_URL=http://localhost:8080

# Enable self-contained simulation demo mode (true/false)
# When set to true or when backend is unreachable, UI auto-simulates cluster events
VITE_DEMO=false
